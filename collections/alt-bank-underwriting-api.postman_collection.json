          "id": "7efa9737-d01a-4415-8184-6638a24788f2",
          "name": "Submit a credit-card underwriting request",
          "request": {
            "name": "Submit a credit-card underwriting request",
            "description": {
              "content": "Starts the underwriting process for a customer. The call is asynchronous — GUARD accepts the request and returns an acknowledgement, then delivers the scoring result to the partner's pre-configured callback endpoint once processing completes. Authenticate with the `X-Partner-Auth` header (a 64-character alphanumeric partner token).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "partner",
                "credit",
                "cards",
                "underwritings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
